{
  "name": "panelflo-weekly-summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 8 * * 1" }]
        }
      },
      "id": "schedule-weekly",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.PANELFLO_API_URL }}/api/n8n/admin-users-with-bot",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.PANELFLO_API_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "http-admins",
      "name": "Fetch Admin Users",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": { "fieldToSplitOut": "data", "options": {} },
      "id": "split-admins",
      "name": "Split Out Admins",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": { "batchSize": 1, "options": {} },
      "id": "batch-admins",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [660, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.PANELFLO_API_URL }}/api/n8n/weekly-stats?workspaceId={{ $json.workspaceId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.PANELFLO_API_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "http-weekly-stats",
      "name": "Fetch Weekly Stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "jsCode": "const admin = $('Split In Batches').first().json;\nconst s = $input.first().json.data;\nconst msg = `Weekly Recap:\\n\\n` +\n  `Tasks: ${s.tasksCompleted} completed / ${s.tasksCreated} created\\n` +\n  `Deals won: ${s.dealsWon} ($${s.dealsWonValue})\\n` +\n  `New contacts: ${s.newContacts}\\n` +\n  `Stale deals: ${s.staleDealsCount}`;\nreturn [{ json: { ...admin, message: msg } }];"
      },
      "id": "code-format-weekly",
      "name": "Format Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "leftValue": "={{ $json.platform }}",
              "rightValue": "telegram",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-platform-weekly",
      "name": "IF Telegram",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1320, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chatId, text: $json.message }) }}",
        "options": {}
      },
      "id": "send-telegram-weekly",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.WHATSAPP_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.chatId, type: 'text', text: { body: $json.message } }) }}",
        "options": {}
      },
      "id": "send-whatsapp-weekly",
      "name": "Send WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 100]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{ "node": "Fetch Admin Users", "type": "main", "index": 0 }]]
    },
    "Fetch Admin Users": {
      "main": [[{ "node": "Split Out Admins", "type": "main", "index": 0 }]]
    },
    "Split Out Admins": {
      "main": [[{ "node": "Split In Batches", "type": "main", "index": 0 }]]
    },
    "Split In Batches": {
      "main": [
        [],
        [{ "node": "Fetch Weekly Stats", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Weekly Stats": {
      "main": [[{ "node": "Format Summary", "type": "main", "index": 0 }]]
    },
    "Format Summary": {
      "main": [[{ "node": "IF Telegram", "type": "main", "index": 0 }]]
    },
    "IF Telegram": {
      "main": [
        [{ "node": "Send Telegram", "type": "main", "index": 0 }],
        [{ "node": "Send WhatsApp", "type": "main", "index": 0 }]
      ]
    },
    "Send Telegram": {
      "main": [[{ "node": "Split In Batches", "type": "main", "index": 0 }]]
    },
    "Send WhatsApp": {
      "main": [[{ "node": "Split In Batches", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
