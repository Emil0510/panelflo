{
  "name": "panelflo-morning-digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 9 * * 1-6" }]
        }
      },
      "id": "schedule-digest",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.PANELFLO_API_URL }}/api/n8n/digest-users",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.PANELFLO_API_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "http-digest-users",
      "name": "Fetch Digest Users",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "id": "split-users",
      "name": "Split Out Users",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": { "batchSize": 1, "options": {} },
      "id": "batch-users",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [660, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.PANELFLO_API_URL }}/api/n8n/daily-brief?userId={{ $json.userId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.PANELFLO_API_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "http-daily-brief",
      "name": "Fetch Daily Brief",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "jsCode": "const user = $('Split In Batches').first().json;\nconst { tasksDueToday, overdueCount, topDeal } = $input.first().json.data;\nconst date = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' });\nlet msg = `Good morning! Here's your ${date} briefing:\\n\\n`;\nif (tasksDueToday.length > 0) {\n  msg += `Tasks due today (${tasksDueToday.length}):\\n`;\n  tasksDueToday.forEach((t, i) => { msg += `${i + 1}. ${t.title}\\n`; });\n} else {\n  msg += 'No tasks due today! ';\n}\nif (overdueCount > 0) msg += `\\nOverdue: ${overdueCount} task(s)`;\nif (topDeal) msg += `\\nTop deal: ${topDeal.title} ($${topDeal.value})`;\nreturn [{ json: { ...user, message: msg } }];"
      },
      "id": "code-format-digest",
      "name": "Format Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "leftValue": "={{ $json.platform }}",
              "rightValue": "telegram",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-platform",
      "name": "IF Telegram",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1320, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chatId, text: $json.message }) }}",
        "options": {}
      },
      "id": "http-send-telegram",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.WHATSAPP_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.chatId, type: 'text', text: { body: $json.message } }) }}",
        "options": {}
      },
      "id": "http-send-whatsapp",
      "name": "Send WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 100]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{ "node": "Fetch Digest Users", "type": "main", "index": 0 }]]
    },
    "Fetch Digest Users": {
      "main": [[{ "node": "Split Out Users", "type": "main", "index": 0 }]]
    },
    "Split Out Users": {
      "main": [[{ "node": "Split In Batches", "type": "main", "index": 0 }]]
    },
    "Split In Batches": {
      "main": [
        [],
        [{ "node": "Fetch Daily Brief", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Daily Brief": {
      "main": [[{ "node": "Format Message", "type": "main", "index": 0 }]]
    },
    "Format Message": {
      "main": [[{ "node": "IF Telegram", "type": "main", "index": 0 }]]
    },
    "IF Telegram": {
      "main": [
        [{ "node": "Send Telegram", "type": "main", "index": 0 }],
        [{ "node": "Send WhatsApp", "type": "main", "index": 0 }]
      ]
    },
    "Send Telegram": {
      "main": [[{ "node": "Split In Batches", "type": "main", "index": 0 }]]
    },
    "Send WhatsApp": {
      "main": [[{ "node": "Split In Batches", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
