        "url": "PANELFLO_API_URL_SUB/api/n8n/agent-tool?key=PANELFLO_API_KEY_SUB",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{requestBody}",
        "placeholderDefinitions": {
          "values": [
            {
              "name": "requestBody",
              "description": "The full JSON request body: {\"userId\": \"<userId from the message>\", \"action\": \"<ACTION_NAME>\", \"data\": {<entity fields>}}. Example: {\"userId\": \"abc123\", \"action\": \"LIST_TASKS\", \"data\": {\"filter\": \"active\"}}",
