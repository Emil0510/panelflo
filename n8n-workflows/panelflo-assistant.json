    {
      "parameters": {
        "jsCode": "const user = $('Split In Batches').first().json;\nconst { tasksDueToday, overdueCount, topDeal } = $input.first().json.data;\nconst date = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' });\nlet msg = `Good morning! Here's your ${date} briefing:\\n\\n`;\nif (tasksDueToday.length > 0) {\n  msg += `Tasks due today (${tasksDueToday.length}):\\n`;\n  tasksDueToday.forEach((t, i) => { msg += `${i + 1}. ${t.title}\\n`; });\n} else {\n  msg += 'No tasks due today! ';\n}\nif (overdueCount > 0) msg += `\\nOverdue: ${overdueCount} task(s)`;\nif (topDeal) msg += `\\nTop deal: ${topDeal.title} ($${topDeal.value})`;\nreturn [{ json: { ...user, message: msg } }];"
      },
